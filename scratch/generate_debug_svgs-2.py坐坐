import xml.etree.ElementTree as ET
import os

def generate_index_atlas(svg_path, output_html):
    if not os.path.exists(svg_path):
        print(f"Error: {svg_path} not found.")
        return

    tree = ET.parse(svg_path)
    root = tree.getroot()
    
    # Modern SVGs might use namespaces
    ns = {'svg': 'http://www.w3.org/2000/svg'}
    paths = root.findall('.//{http://www.w3.org/2000/svg}path')
    if not paths:
        paths = root.findall('.//path') # Fallback for no NS
        
    print(f"Found {len(paths)} paths in {svg_path}")
    
    html_content = f"""
    <html>
    <head>
        <title>SVG Index Atlas: {os.path.basename(svg_path)}</title>
        <style>
            body {{ background: #0a0a0f; color: white; font-family: sans-serif; display: flex; flex-direction: column; align-items: center; }}
            .container {{ position: relative; width: 600px; height: 800px; border: 1px solid #333; margin-top: 20px; }}
            svg {{ width: 100%; height: 100%; }}
            path:hover {{ fill: #ff4d4d !important; cursor: pointer; }}
            .overlay {{ position: absolute; top: 0; left: 0; pointer-events: none; width: 100%; height: 100%; }}
            .tooltip {{ background: red; color: white; padding: 2px 5px; font-size: 10px; border-radius: 3px; position: absolute; opacity: 0; transition: opacity 0.2s; }}
            .list {{ display: flex; flex-wrap: wrap; gap: 10px; padding: 20px; max-width: 1200px; }}
            .item {{ background: #1a1a2e; padding: 5px 10px; border-radius: 5px; border: 1px solid #333; font-size: 12px; }}
        </style>
    </head>
    <body>
        <h1>{os.path.basename(svg_path)} - Index Atlas</h1>
        <div class="container" id="svg-container">
            <!-- SVG content will be injected here -->
        </div>
        <div class="list">
    """
    
    # Inject SVG with indices
    svg_str = ET.tostring(root, encoding='unicode')
    # Add unique IDs to paths for JS interaction
    for i in range(len(paths)):
        html_content += f'<div class="item">Path {i}</div>'
    
    html_content += """
        </div>
        <script>
            const container = document.getElementById('svg-container');
            const svgRaw = `""" + svg_str.replace("`", "\\`") + """`;
            container.innerHTML = svgRaw;
            const paths = container.querySelectorAll('path');
            paths.forEach((p, i) => {
                p.setAttribute('data-index', i);
                p.addEventListener('mouseenter', (e) => {
                    console.log('Hovered Path:', i);
                    p.style.fill = 'red';
                });
                p.addEventListener('mouseleave', () => {
                    p.style.fill = '';
                });
                // Optional: add text labels at centroid (approximation)
                const bbox = p.getBBox();
                const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
                text.setAttribute('x', bbox.x + bbox.width/2);
                text.setAttribute('y', bbox.y + bbox.height/2);
                text.setAttribute('fill', 'white');
                text.setAttribute('font-size', '5px');
                text.setAttribute('pointer-events', 'none');
                text.textContent = i;
                container.querySelector('svg').appendChild(text);
            });
        </script>
    </body>
    </html>
    """
    
    with open(output_html, 'w', encoding='utf-8') as f:
        f.write(html_content)
    print(f"Atlas generated at {output_html}")

if __name__ == "__main__":
    generate_index_atlas('public/body front.svg', 'scratch/atlas_front.html')
    generate_index_atlas('public/body back.svg', 'scratch/atlas_back.html')
